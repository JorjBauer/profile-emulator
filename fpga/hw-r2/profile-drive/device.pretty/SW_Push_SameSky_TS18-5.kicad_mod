(footprint "SW_Push_SameSky_TS18-5"
  (layer "F.Cu")
  (descr "Same Sky TS18-5-xx-SL-xxx-SMT-TR tactile switch, 5.2 x 5.2 mm body, 1.5 mm and up actuator height, 4 terminals. Land pattern is the datasheet's Recommended PCB Layout (ts18.pdf page 2): pads 1.7 x 1.0 mm, 8.0 mm overall and 4.6 mm inner gap along X, 4.8 mm overall and 2.8 mm inner gap along Y. Terminals 1 and 2 are tied together inside (top row). Terminals 3 and 4 are tied together (bottom row). The switch closes between the two rows. So the two pads of each row carry the same pad number: 1 = top row, 2 = bottom row. Also fits the generic 5x5x1.5 mm 4-terminal SMD tact switches (XKB TS-1187A style, 3.7 mm terminal pitch, 6.4 mm lead span).")
  (tags "tactile switch SMD 5.2x5.2 Same Sky TS18 XKB TS-1187A")
  (fp_text user "${REFERENCE}" (at 0 0 0) (layer "F.Fab") (effects (font (size 0.8 0.8) (thickness 0.12))))
  (attr smd)
  (property "Reference" "REF**" (at 0 -3.9 0) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
  (property "Value" "SW_Push_SameSky_TS18-5" (at 0 3.9 0) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))
  (fp_line (start -2.2 -2.6) (end 2.2 -2.6) (stroke (width 0.15) (type solid)) (layer "F.SilkS"))
  (fp_line (start -2.2 2.6) (end 2.2 2.6) (stroke (width 0.15) (type solid)) (layer "F.SilkS"))
  (fp_line (start -2.6 -1.2) (end -2.6 1.2) (stroke (width 0.15) (type solid)) (layer "F.SilkS"))
  (fp_line (start 2.6 -1.2) (end 2.6 1.2) (stroke (width 0.15) (type solid)) (layer "F.SilkS"))
  (fp_circle (center 0 0) (end 1.1 0) (stroke (width 0.15) (type solid)) (fill none) (layer "F.SilkS"))
  (fp_rect (start -2.6 -2.6) (end 2.6 2.6) (stroke (width 0.1) (type solid)) (fill none) (layer "F.Fab"))
  (fp_rect (start -4.25 -3.1) (end 4.25 3.1) (stroke (width 0.05) (type solid)) (fill none) (layer "F.CrtYd"))
  (pad "1" smd roundrect (at -3.15 -1.9) (size 1.7 1.0) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.15))
  (pad "1" smd roundrect (at 3.15 -1.9) (size 1.7 1.0) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.15))
  (pad "2" smd roundrect (at -3.15 1.9) (size 1.7 1.0) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.15))
  (pad "2" smd roundrect (at 3.15 1.9) (size 1.7 1.0) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.15))
)
