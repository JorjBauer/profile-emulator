(footprint "microSD_GCT_MEM2075"
  (layer "F.Cu")
  (descr "GCT MEM2075-00-140-01-A microSD push-push, from the maker's drawing (https://gct.co/files/drawings/mem2075.pdf, rev A1, sheet 1/2, 'Recommended PCB Layout, as viewed from component side'). Origin = midpoint of the two locating posts in X, center of the contact-pad row in Y. +Y runs into the board away from the contacts toward the card slot; the card's mouth is at Y = 15.40. Contact pads: pitch 1.10, 9 x 0.62 x 1.40 (P1 at X = 2.58, the card-detect pad at X = -6.22). Ground (shell) pads: 4 x 1.10 x 2.40, at X = -7.60 (1.38 outside the card-detect pad) and X = 8.55 (5.97 outside P1), 16.15 apart; Y = 2.00 and 11.00 (9.00 between the pairs). Locating holes: diameter 0.95, 6.80 apart (X = +/-3.40), 0.42 beyond the lower ground pads at Y = 11.42, and 3.98 short of the mouth. Corrected 2026-10-06 after an independent audit against the drawing; the first version put the holes at Y = 9.54 and the shell pads 0.5 mm off.")
  (tags "microSD MEM2075 GCT push-push")
  (fp_text user "${REFERENCE}" (at 0.5 8.0 0) (layer "F.Fab") (effects (font (size 0.8 0.8) (thickness 0.12))))
  (attr smd)
  (property "Reference" "REF**" (at 0 -2.5 0) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
  (property "Value" "microSD_GCT_MEM2075" (at 0 17.0 0) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))
  (fp_text user "card inserts this side ->" (at 0 16.4 0) (layer "F.Fab") (effects (font (size 0.8 0.8) (thickness 0.12))))
  (fp_line (start -8.6 -1.0) (end 9.55 -1.0) (stroke (width 0.15) (type solid)) (layer "F.SilkS"))
  (fp_line (start -8.6 -1.0) (end -8.6 15.5) (stroke (width 0.15) (type solid)) (layer "F.SilkS"))
  (fp_line (start 9.55 -1.0) (end 9.55 15.5) (stroke (width 0.15) (type solid)) (layer "F.SilkS"))
  (fp_line (start -8.6 15.5) (end 9.55 15.5) (stroke (width 0.15) (type solid)) (layer "F.SilkS"))
  (fp_rect (start -8.85 -1.25) (end 9.8 15.75) (stroke (width 0.05) (type solid)) (fill none) (layer "F.CrtYd"))
  (fp_rect (start -7.04 0.75) (end 7.99 15.40) (stroke (width 0.1) (type solid)) (fill none) (layer "F.Fab"))
  (fp_text user "keepout: no copper/via (card contacts)" (at 0.5 5.0 0) (layer "F.Fab") (effects (font (size 0.6 0.6) (thickness 0.1))))
  (pad "9" smd roundrect (at -6.22 0) (size 0.62 1.40) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.25))
  (pad "8" smd roundrect (at -5.12 0) (size 0.62 1.40) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.25))
  (pad "7" smd roundrect (at -4.02 0) (size 0.62 1.40) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.25))
  (pad "6" smd roundrect (at -2.92 0) (size 0.62 1.40) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.25))
  (pad "5" smd roundrect (at -1.82 0) (size 0.62 1.40) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.25))
  (pad "4" smd roundrect (at -0.72 0) (size 0.62 1.40) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.25))
  (pad "3" smd roundrect (at 0.38 0) (size 0.62 1.40) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.25))
  (pad "2" smd roundrect (at 1.48 0) (size 0.62 1.40) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.25))
  (pad "1" smd roundrect (at 2.58 0) (size 0.62 1.40) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.25))
  (pad "10" smd roundrect (at -7.60 2.00) (size 1.10 2.40) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.15))
  (pad "10" smd roundrect (at 8.55 2.00) (size 1.10 2.40) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.15))
  (pad "10" smd roundrect (at -7.60 11.00) (size 1.10 2.40) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.15))
  (pad "10" smd roundrect (at 8.55 11.00) (size 1.10 2.40) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.15))
  (pad "" np_thru_hole circle (at -3.40 11.42) (size 0.95 0.95) (drill 0.95) (layers "*.Cu" "*.Mask"))
  (pad "" np_thru_hole circle (at 3.40 11.42) (size 0.95 0.95) (drill 0.95) (layers "*.Cu" "*.Mask"))
)
