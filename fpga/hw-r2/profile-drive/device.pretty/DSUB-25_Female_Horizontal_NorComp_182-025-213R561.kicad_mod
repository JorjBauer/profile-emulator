(footprint "DSUB-25_Female_Horizontal_NorComp_182-025-213R561"
  (layer "F.Cu")
  (descr "NorComp 182-025-213R561, DB-25 female, right angle, 0.318 in footprint, board locks in hole, 4-40 hex standoff screwlocks. From NorComp drawing 182-YYY-213RYY1 rev 18 (https://content.norcomp.net/rohspdfs/Connectors/18Y/182/182-yyy-213Ryy1.pdf), Recommended PCB Layout: pins 2.77 pitch, rows 2.84 apart, holes 1.19; board-lock holes 3.2 mm, 47.04 mm apart, midway between the two rows (1.42 from each); the near row (14 to 25) 8.08 mm behind the flange. Pin 1 at the origin, the near row toward +Y, the mating face (and the board edge, at the flange rear face) at Y = 10.92. KiCad's DSUB-25 EdgePinOffset4.94mm footprint, used on r1, puts the board locks in line with the near row and the flange 3.14 mm closer to the pins: it does not fit this part.")
  (tags "DB25 D-Sub female right angle NorComp 182")
  (fp_text user "${REFERENCE}" (at -16.62 5.5 0) (layer "F.Fab") (effects (font (size 0.8 0.8) (thickness 0.12))))
  (attr through_hole)
  (property "Reference" "REF**" (at -16.62 -2.6 0) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
  (property "Value" "NorComp 182-025-213R561" (at -16.62 5.5 0) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))
