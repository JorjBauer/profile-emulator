(footprint "DSUB-25_Female_Horizontal_NorComp_182-025-213R561"
  (layer "F.Cu")
  (descr "NorComp 182-025-213R561, DB-25 female, right angle, 0.318 in footprint, board locks in hole, 4-40 hex standoff screwlocks. From NorComp drawing 182-YYY-213RYY1 rev 18 (https://content.norcomp.net/rohspdfs/Connectors/18Y/182/182-yyy-213Ryy1.pdf), Recommended PCB Layout: pins 2.77 pitch, rows 2.84 apart, holes 1.19 (1.2 here); board-lock holes 3.2 mm, 47.04 mm apart, midway between the two rows. NorComp gives 0.318 in (8.08 mm) from the near row (14 to 25) to the flange FRONT face; with a 0.40 mm flange the rear face, which sits on the board edge, is 7.70 mm from the near row, the same as KiCad DSUB-25_Socket_Horizontal_P2.77x2.84mm_EdgePinOffset7.70mm_Housed_MountingHolesOffset9.12mm. Checked against the r1 board on 2026-10-09: the connector stands about 4 mm past the r1 edge, near row 4.445 mm in, so its flange is about 8.4 mm from the near row. The r1 board locks (in line with the near row) were 1 to 2 mm too close to the edge. Pin 1 at the origin, the near row toward +Y, the board edge at Y = 10.54.")
  (tags "DB25 D-Sub female right angle NorComp 182")
  (property "Reference" "REF**" (at -16.62 -2.6 0) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
  (property "Value" "NorComp 182-025-213R561" (at -16.62 5.5 0) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))
  (fp_text user "${REFERENCE}" (at -16.62 5.5 0) (layer "F.Fab") (effects (font (size 0.8 0.8) (thickness 0.12))))
