  (text "ProFile drive replacement" (exclude_from_sim no) (at 15.24 20.32 0) (effects (font (size 3 3) bold) (justify left top)) (uuid "00b05ea5-645c-5728-902c-3292dc18c5ba"))
  (text "LFE5U-12F (built as a 25F) on a single board with a DB-25 to the //e's ProFile interface card,\na microSD holding the disk images, USB-C for power, and headers for JTAG, flash and the console." (exclude_from_sim no) (at 15.24 30.48 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "24c1bfc3-cf4e-5bcd-9704-5395a6f044a3"))
  (text "USB-C input, 1.1 V and 3.3 V bucks, 2.5 V VCCAUX LDO" (exclude_from_sim no) (at 15.24 91.44 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "8098f0dc-1ba2-5fbb-ad81-5674bf5089b9"))
  (text "FPGA supply pins with their decoupling; unused IO" (exclude_from_sim no) (at 109.22 91.44 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "385e3e04-7fe9-5b0f-bbe6-c5050912fdcb"))
