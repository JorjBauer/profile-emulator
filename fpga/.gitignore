# Build products. `make clean` removes all of these.
# The selector blobs are derived from ../selector/selector_blobs.h on demand.
src/blobs/*.hex
.build_id
profile_emu_*.json
profile_emu_*.config
profile_emu_*.bit
profile_emu_*.bin
*.buildid
*.bit.cfg
# Editor backups
*~

# KiCad backups. The hand snapshots taken before each risky layout edit, plus
# KiCad's own auto-backups.
*.kicad_pcb.bak-*
*.kicad_pro.bak-*
*.kicad_sch.bak-*
*.kicad_sym.bak-*
*-backups/
*.kicad_pcb-bak

# KiCad's per-user view and selection settings. The lock flags themselves
# live in the board file.
*.kicad_prl

# Plot output from the hw-r2 scripts; the zips are what's committed.
gerb/
stencil-alt/
